# LM Studio OpenAI-compatible server settings.
# Start LM Studio local server before running the backend.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=qwen2.5-7b-instruct

# Qwen2.5-7B-Instruct Q4_K_M works better here with low temperature and explicit JSON repair retries.
LLM_TEMPERATURE=0.35
LLM_MAX_TOKENS=1200
LLM_JSON_RETRIES=2
LLM_TIMEOUT_SECONDS=120
LLM_USE_RESPONSE_FORMAT=false

# App settings.
MEETING_STORAGE_DIR=./data/meetings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

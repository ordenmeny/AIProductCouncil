# LM Studio OpenAI-compatible server settings.
# Start LM Studio local server and load google/gemma-4-e4b before running the backend.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=google/gemma-4-e4b

# Gemma test profile: keep generation conservative because the orchestrator expects valid JSON.
LLM_TEMPERATURE=0.25
LLM_MAX_TOKENS=1600
LLM_JSON_RETRIES=3
LLM_TIMEOUT_SECONDS=180
LLM_USE_RESPONSE_FORMAT=false

# App settings.
MEETING_STORAGE_DIR=./data/meetings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
